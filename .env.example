# ─────────────────────────────────────────────────────────────────
#  MoonFluxx environment variables
#  Copy this file to .env.local and fill in YOUR OWN dev values.
#  NEVER commit .env.local. NEVER put production keys here.
# ─────────────────────────────────────────────────────────────────

# ── Solana ───────────────────────────────────────────────────────
NEXT_PUBLIC_PROGRAM_ID=DrVK92avUZvKHbyxd3StwX9c3zkZf5nDNoBrgU32e1NE
NEXT_PUBLIC_FEE_RECIPIENT=YOUR_FEE_RECIPIENT_WALLET
NEXT_PUBLIC_NETWORK=devnet
# Get your own free key at https://dashboard.helius.dev
NEXT_PUBLIC_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ── Helius (webhooks + enhanced RPC) ─────────────────────────────
HELIUS_API_KEY=YOUR_HELIUS_API_KEY
HELIUS_WEBHOOK_SECRET=YOUR_HELIUS_WEBHOOK_SECRET

# ── Price APIs ───────────────────────────────────────────────────
NEXT_PUBLIC_JUPITER_PRICE_URL=https://api.jup.ag/price/v2

# ── Supabase (use the DEV project, not production) ───────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── AI (NVIDIA NIM — powers all AI features) ─────────────────────
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY

# ── IPFS (Pinata — token metadata storage) ───────────────────────
# Optional in dev: without it, uploads fall back to mock metadata
PINATA_JWT=YOUR_PINATA_JWT

# ── Cron / admin ─────────────────────────────────────────────────
CRON_SECRET=GENERATE_A_RANDOM_SECRET_HERE
# JSON byte array of a DEVNET keypair used by the migration cron.
# Use your own devnet wallet. Never the real admin/mainnet key.
ADMIN_KEYPAIR=

# ── Local scripts only (scripts/e2e-*.js) ────────────────────────
# Defaults: public devnet RPC and ~/.config/solana/id.json
# SOLANA_RPC_URL=https://api.devnet.solana.com
# WALLET_PATH=/path/to/your/devnet-wallet.json
